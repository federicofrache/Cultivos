rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cualquier usuario que haya iniciado sesión (con su usuario y
    // contraseña de la app) puede leer y escribir todos los datos.
    // Es un espacio de trabajo compartido para tu equipo.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
