rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Un usuario tiene "rol de lectura" si existe un documento en /usuarios
    // con su email como ID y rol == "lectura". Si no existe ese documento
    // (caso por defecto, incluye a todos los usuarios ya existentes antes
    // de este cambio), se lo trata como editor normal — así nadie queda
    // bloqueado por accidente.
    function esSoloLectura() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data.rol == "lectura";
    }

    // Cualquier usuario logueado puede LEER todos los datos (espacio de
    // trabajo compartido). Para ESCRIBIR (crear/editar/borrar) hace falta
    // además no tener el rol de solo lectura.
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && !esSoloLectura();
    }
  }
}
